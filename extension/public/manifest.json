{
  "manifest_version": 3,
  "name": "Chatables",
  "version": "1.0.0",
  "description": "Privacy-First Anonymous Chat. Click, Match, Talk, Leave, Everything disappears.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "action": {},
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "109"
}
